NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://lingua:replace_me@localhost:5434/lingua?schema=public&connection_limit=8&pool_timeout=10
SESSION_DATABASE_URL=postgresql://lingua:replace_me@localhost:5434/lingua
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=lingua.sid
SESSION_COOKIE_SECURE=true
APP_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=1
FILE_ROOT=./uploads
UPLOAD_TMP_ROOT=./tmp
INTERNAL_FILE_PREFIX=/_protected_files
DOCS_ENABLED=true
OPERATOR_TOKEN=replace-with-a-long-random-operator-token
